{
  "schemaVersion": 2,
  "domains": ["RT", "INT", "DOM", "CTL", "AUTH"],
  "codes": [
    {
      "code": "RT.DB.TIMEOUT",
      "domain": "RT",
      "retryable": true,
      "remediation": "Retry with exponential backoff (max 3 attempts).",
      "severity": "error",
      "alert": "pager"
    },
    {
      "code": "RT.DB.CORRUPTION",
      "domain": "RT",
      "retryable": false,
