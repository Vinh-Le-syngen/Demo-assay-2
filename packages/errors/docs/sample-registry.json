      "severity": "warn",
      "alert": "none"
    },
    {
      "code": "INT.STRIPE.TIMEOUT",
      "domain": "INT",
      "retryable": true,
      "message": "Stripe API did not respond in time.",
      "remediation": "Retry once after 2 s; if still failing, alert billing team.",
      "severity": "error",
      "alert": "slack-billing"
    },
    {
      "code": "DOM.INVARIANT.VIOLATED",
      "domain": "DOM",
      "retryable": false,
