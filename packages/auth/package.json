{
  "name": "@sys/auth",
  "version": "0.0.1",
  "description": "Control-plane authentication & authorization subsystem. Configurable, reusable, 5-plane-aligned.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js",
      "require": "./dist/server/index.cjs"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js",
      "require": "./dist/react/index.cjs"
    },
    "./middleware": {
      "types": "./dist/middleware/index.d.ts",
      "import": "./dist/middleware/index.js",
      "require": "./dist/middleware/index.cjs"
    },
    "./adapters/supabase": {
      "types": "./dist/adapters/supabase.d.ts",
      "import": "./dist/adapters/supabase.js",
      "require": "./dist/adapters/supabase.cjs"
    },
    "./observability": {
      "types": "./dist/observability/index.d.ts",
      "import": "./dist/observability/index.js",
      "require": "./dist/observability/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./method-passkey": {
      "types": "./dist/method-passkey.d.ts",
      "import": "./dist/method-passkey.js",
      "require": "./dist/method-passkey.cjs"
    },
    "./method-national-id": {
      "types": "./dist/method-national-id.d.ts",
      "import": "./dist/method-national-id.js",
      "require": "./dist/method-national-id.cjs"
    },
    "./method-password": {
      "types": "./dist/method-password.d.ts",
      "import": "./dist/method-password.js",
      "require": "./dist/method-password.cjs"
    },
    "./method-oauth": {
      "types": "./dist/method-oauth.d.ts",
      "import": "./dist/method-oauth.js",
      "require": "./dist/method-oauth.cjs"
    },
    "./method-magiclink": {
      "types": "./dist/method-magiclink.d.ts",
      "import": "./dist/method-magiclink.js",
      "require": "./dist/method-magiclink.cjs"
    },
    "./method-otp": {
      "types": "./dist/method-otp.d.ts",
      "import": "./dist/method-otp.js",
      "require": "./dist/method-otp.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "jose": "^6.2.0",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
