{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sys.dev/schema/release-set.schema.json",
  "title": "ReleaseSet",
  "description": "A calendar-versioned, provenance-bearing bundle of @sys/* package + contract versions. Provenance mirrors @sys/canon. Mirrors releaseSetSchema in @sys/release; zod is the runtime source of truth.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "status", "packages", "evidence"],
  "properties": {
    "schema_version": { "const": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d{4}\\.\\d{2}\\.\\d+$" },
    "status": { "enum": ["draft", "approved", "live", "superseded"] },
    "packages": {
      "type": "object",
      "additionalProperties": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$" }
    },
    "contracts": {
      "type": "object",
      "additionalProperties": { "type": "integer" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "ref"],
        "properties": { "source": { "type": "string" }, "ref": { "type": "string" } }
      }
    },
    "owner": { "type": "string" },
    "approved_by": { "type": "string" },
    "created_at": { "type": "string" },
    "last_reviewed": { "type": "string" },
    "expires_at": { "type": "string" },
    "superseded_by": { "type": "string" },
    "notes": { "type": "string" }
  }
}
