{
  "name": "@sys/groundskeeper",
  "version": "0.0.1",
  "description": "Operational-hygiene detectors — run, summarize, and alert. Reusable detector builders; library or `sys-groundskeeper` CLI.",
  "type": "module",
  "license": "UNLICENSED",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "sys-groundskeeper": "./dist/cli.js"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./detectors": {
      "types": "./dist/detectors.d.ts",
      "import": "./dist/detectors.js",
      "require": "./dist/detectors.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}
